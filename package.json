{
  "scripts": {
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:worker": "node --test worker/test/*.test.mjs",
    "test:production": "node scripts/test-production.mjs",
    "test:occupied-port": "node scripts/test-occupied-port.mjs",
    "test": "npm run test:worker && npm run test:e2e",
    "test:quiet": "node --test --test-reporter=dot worker/test/*.test.mjs && node ./node_modules/@playwright/test/cli.js test --reporter=dot",
    "test:visual": "node ./node_modules/@playwright/test/cli.js test --config playwright.visual.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
